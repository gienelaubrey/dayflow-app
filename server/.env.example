DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
PORT=4000
NODE_ENV="development"
SESSION_DAYS=30

# Development only when Vite runs separately on port 5173.
# Production can leave this blank when Express serves the built frontend.
CLIENT_ORIGIN="http://localhost:5173"

# Email verification / password reset (Resend)
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="DayFlow <verify@your-verified-domain.com>"

# Generate a long random value. Never commit the real secret.
OTP_SECRET="replace_with_at_least_32_random_characters"
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=45
OTP_MAX_ATTEMPTS=5

# In-memory per-instance request limits (15-minute windows).
API_RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=60
