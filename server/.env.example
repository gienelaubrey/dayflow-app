# PostgreSQL connection string.
# Example for local PostgreSQL:
# DATABASE_URL="postgresql://dayflow:change-me@localhost:5432/dayflow?schema=public"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dayflow?schema=public"

# Frontend dev URL. Keep this exact while Vite runs on its default port.
CLIENT_ORIGIN="http://localhost:5173"

PORT=4000
NODE_ENV="development"

# Session lifetime in days.
SESSION_DAYS=30
