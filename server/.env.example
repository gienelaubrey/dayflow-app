DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/dayflow?schema=public"
CLIENT_ORIGIN="http://localhost:5173"
PORT=4000
NODE_ENV="development"
SESSION_DAYS=30

# Email verification (Resend)
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="DayFlow <onboarding@resend.dev>"

# Generate a long random secret. Do not share or commit the real value.
OTP_SECRET="replace_with_at_least_32_random_characters"
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=45
OTP_MAX_ATTEMPTS=5
